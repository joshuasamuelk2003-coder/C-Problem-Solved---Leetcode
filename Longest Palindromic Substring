#include <stdlib.h>
#include <string.h>

int expandAroundCenter(char* s, int n, int left, int right) {
    while (left >= 0 && right < n && s[left] == s[right]) {
        left--;
        right++;
    }

    return right - left - 1;
}

char* longestPalindrome(char* s) {
    int n = strlen(s);

    int start = 0;
    int end = 0;

    for (int i = 0; i < n; i++) {
        int len1 = expandAroundCenter(s, n, i, i);       // Odd length palindrome
        int len2 = expandAroundCenter(s, n, i, i + 1);   // Even length palindrome

        int len = len1 > len2 ? len1 : len2;

        if (len > end - start + 1) {
            start = i - (len - 1) / 2;
            end = i + len / 2;
        }
    }

    int resultLength = end - start + 1;

    char* result = (char*)malloc((resultLength + 1) * sizeof(char));

    strncpy(result, s + start, resultLength);
    result[resultLength] = '\0';

    return result;
}
