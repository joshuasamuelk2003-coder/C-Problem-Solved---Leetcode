#include <limits.h>

int myAtoi(char *s) {
    int i = 0;
    int sign = 1;
    int result = 0;

    // Skip leading whitespaces
    while (s[i] == ' ')
        i++;

    // Check for sign
    if (s[i] == '+' || s[i] == '-') {
        if (s[i] == '-')
            sign = -1;
        i++;
    }

    // Convert digits
    while (s[i] >= '0' && s[i] <= '9') {
        int digit = s[i] - '0';

        // Check for overflow/underflow
        if (result > INT_MAX / 10 ||
            (result == INT_MAX / 10 && digit > (sign == 1 ? 7 : 8))) {
            return (sign == 1) ? INT_MAX : INT_MIN;
        }

        result = result * 10 + digit;
        i++;
    }

    return sign * result;
}
