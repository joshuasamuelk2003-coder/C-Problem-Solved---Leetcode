struct ListNode* deleteDuplicates(struct ListNode* head) {
    struct ListNode dummy;
    dummy.next = head;

    struct ListNode* prev = &dummy;
    struct ListNode* curr = head;

    while (curr != NULL) {
        int duplicate = 0;

        while (curr->next != NULL && curr->val == curr->next->val) {
            duplicate = 1;
            curr = curr->next;
        }

        if (duplicate) {
            prev->next = curr->next;
        } else {
            prev = prev->next;
        }

        curr = curr->next;
    }

    return dummy.next;
}
