#include <stdlib.h>

void backtrack(int* nums, int numsSize, int start, int* path,
               int depth, int** result, int* count, int* colSizes) {
    result[*count] = malloc((depth > 0 ? depth : 1) * sizeof(int));

    for (int i = 0; i < depth; i++) {
        result[*count][i] = path[i];
    }

    colSizes[*count] = depth;
    (*count)++;

    for (int i = start; i < numsSize; i++) {
        path[depth] = nums[i];

        backtrack(nums, numsSize, i + 1, path, depth + 1,
                  result, count, colSizes);
    }
}

int** subsets(int* nums, int numsSize, int* returnSize,
              int** returnColumnSizes) {
    int total = 1 << numsSize;

    int** result = malloc(total * sizeof(int*));
    int* colSizes = malloc(total * sizeof(int));
    int* path = malloc(numsSize * sizeof(int));

    int count = 0;

    backtrack(nums, numsSize, 0, path, 0,
              result, &count, colSizes);

    *returnSize = count;
    *returnColumnSizes = colSizes;

    free(path);
    return result;
}
