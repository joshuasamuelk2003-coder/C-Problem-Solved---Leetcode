#include <string.h>

#define MAX(a, b) ((a) > (b) ? (a) : (b))

int longestValidParentheses(char* s) {
    if (!s) return 0;
    
    int n = strlen(s);
    int max_len = 0;
    int left = 0, right = 0;

    // 1. Left-to-Right Scan
    for (int i = 0; i < n; i++) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }
        
        if (left == right) {
            max_len = MAX(max_len, 2 * right);
        } else if (right > left) {
            left = 0;
            right = 0;
        }
    }

    // Reset counters for the reverse scan
    left = 0;
    right = 0;

    // 2. Right-to-Left Scan
    for (int i = n - 1; i >= 0; i--) {
        if (s[i] == '(') {
            left++;
        } else {
            right++;
        }
        
        if (left == right) {
            max_len = MAX(max_len, 2 * left);
        } else if (left > right) {
            left = 0;
            right = 0;
        }
    }

    return max_len;
}
