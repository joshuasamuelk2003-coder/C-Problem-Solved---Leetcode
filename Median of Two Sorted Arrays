#include <limits.h>

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Always binary search on the smaller array
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }

    int m = nums1Size;
    int n = nums2Size;

    int low = 0;
    int high = m;

    while (low <= high) {
        int partition1 = (low + high) / 2;
        int partition2 = (m + n + 1) / 2 - partition1;

        int maxLeft1, minRight1;
        int maxLeft2, minRight2;

        if (partition1 == 0)
            maxLeft1 = INT_MIN;
        else
            maxLeft1 = nums1[partition1 - 1];

        if (partition1 == m)
            minRight1 = INT_MAX;
        else
            minRight1 = nums1[partition1];

        if (partition2 == 0)
            maxLeft2 = INT_MIN;
        else
            maxLeft2 = nums2[partition2 - 1];

        if (partition2 == n)
            minRight2 = INT_MAX;
        else
            minRight2 = nums2[partition2];

        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {
            // Odd total length
            if ((m + n) % 2 == 1) {
                return maxLeft1 > maxLeft2 ? maxLeft1 : maxLeft2;
            }

            // Even total length
            int leftMax = maxLeft1 > maxLeft2 ? maxLeft1 : maxLeft2;
            int rightMin = minRight1 < minRight2 ? minRight1 : minRight2;

            return (leftMax + rightMin) / 2.0;
        }
        else if (maxLeft1 > minRight2) {
            high = partition1 - 1;
        }
        else {
            low = partition1 + 1;
        }
    }

    return 0.0;
}
