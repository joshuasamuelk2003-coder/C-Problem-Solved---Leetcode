#include <stdlib.h>
#include <string.h>

int minDistance(char* word1, char* word2) {
    int m = strlen(word1);
    int n = strlen(word2);

    int* dp = malloc((n + 1) * sizeof(int));

    for (int j = 0; j <= n; j++) {
        dp[j] = j;
    }

    for (int i = 1; i <= m; i++) {
        int prev = dp[0];
        dp[0] = i;

        for (int j = 1; j <= n; j++) {
            int temp = dp[j];

            if (word1[i - 1] == word2[j - 1]) {
                dp[j] = prev;
            } else {
                int insert = dp[j - 1];
                int delete = dp[j];
                int replace = prev;

                int min = insert < delete ? insert : delete;
                if (replace < min) min = replace;

                dp[j] = min + 1;
            }

            prev = temp;
        }
    }

    int result = dp[n];
    free(dp);

    return result;
}
