#include <limits.h>
#include <stdbool.h>

int divide(int dividend, int divisor) {
    // 1. Handle the 32-bit signed integer overflow edge case
    if (dividend == INT_MIN && divisor == -1) {
        return INT_MAX;
    }

    // 2. Determine the sign of the result
    bool is_negative = (dividend < 0) ^ (divisor < 0);

    // 3. Safe bit copy to unsigned variables
    unsigned int u_dividend = (unsigned int)dividend;
    unsigned int u_divisor = (unsigned int)divisor;

    // 4. Get absolute values using pure unsigned arithmetic (well-defined overflow)
    unsigned int abs_dividend = (dividend < 0) ? (0U - u_dividend) : u_dividend;
    unsigned int abs_divisor = (divisor < 0) ? (0U - u_divisor) : u_divisor;

    unsigned int quotient = 0;

    // 5. Single-pass linear bit-shift from the maximum 31st bit down to 0
    for (int i = 31; i >= 0; i--) {
        if ((abs_dividend >> i) >= abs_divisor) {
            abs_dividend -= (abs_divisor << i);
            quotient |= (1U << i);
        }
    }

    // 6. Return the signed quotient without using the signed unary minus (-) operator
    if (is_negative) {
        return (int)(0U - quotient);
    }
    return (int)quotient;
}
